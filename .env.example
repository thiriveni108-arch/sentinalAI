# Safe by default. Set true only for deterministic demo deployments.
SENTINEL_BOOTSTRAP_DEMO_DATA=false

# For Render with a persistent disk, point this at the mounted disk path.
SENTINEL_DATABASE_PATH=data/sentinel_ai.db

# Simulated response policy. No enterprise identity provider is called.
AUTO_CONTAINMENT_ENABLED=true
AUTO_CONTAINMENT_RISK_THRESHOLD=100
# Temporary public-demo boundary. Generate one secret and configure the same
# value in the local backend and Vercel server environment. Never use NEXT_PUBLIC_.
SENTINEL_PUBLIC_DEMO_MODE=false
SENTINEL_DEMO_API_SECRET=

# Backend-only second factor for model-policy governance mutations. Do not set
# this on Vercel unless a trusted server-only governance workflow requires it.
SENTINEL_MODEL_GOVERNANCE_TOKEN=
