# Set to 'http' to connect to the Railway FastAPI backend.
# (If set to 'fixture' or left empty, the frontend renders offline fixture data.)
SENTINEL_DATA_SOURCE=http

# Public HTTPS URL of your Railway FastAPI backend service (without trailing slash).
# Example: https://sentinelai-production.up.railway.app
SENTINEL_API_BASE_URL=https://your-railway-app.up.railway.app

# Shared secret key matching SENTINEL_API_KEY on the Railway backend.
# Enforces access control on all state-changing operations (incident injection, SHIELD approval/execution, learning).
SENTINEL_API_KEY=your-secure-demo-api-key
